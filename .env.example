# ============================================================
# 支付宝基金智能分析系统 - 配置文件
# 复制本文件为 .env 并填写配置
# ============================================================

# === 基金列表 (逗号分隔) ===
DFA_FUND_CODES=161725,110011,005827

# === LLM 主模型 ===
DFA_LLM_PRIMARY_MODEL=gpt-4o-mini
DFA_LLM_PRIMARY_API_KEY=sk-xxx
DFA_LLM_PRIMARY_BASE_URL=https://api.openai.com/v1

# === LLM 备选模型 (主模型失败时自动切换) ===
DFA_LLM_FALLBACK_MODEL=deepseek-chat
DFA_LLM_FALLBACK_API_KEY=sk-xxx
DFA_LLM_FALLBACK_BASE_URL=https://api.deepseek.com

# === LLM 参数 ===
DFA_LLM_MAX_TOKENS=2000
DFA_LLM_TEMPERATURE=0.3

# === 通知渠道 (按需配置，至少配置一个) ===

# 企业微信 Webhook
DFA_WECHAT_WEBHOOK_URL=

# Telegram Bot
DFA_TELEGRAM_BOT_TOKEN=
DFA_TELEGRAM_CHAT_ID=

# 邮件 (SMTP)
DFA_EMAIL_SMTP_HOST=smtp.qq.com
DFA_EMAIL_SMTP_PORT=465
DFA_EMAIL_SENDER=
DFA_EMAIL_PASSWORD=
DFA_EMAIL_RECEIVERS=

# 飞书 Webhook
DFA_FEISHU_WEBHOOK_URL=

# === 分析参数 ===
DFA_RISK_FREE_RATE=0.025
DFA_NAV_HISTORY_DAYS=365

# === 存储 ===
DFA_DATABASE_URL=sqlite:///data/fund_analysis.db

# === 通知开关 ===
DFA_NOTIFY_ENABLED=true
